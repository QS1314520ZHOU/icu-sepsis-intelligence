# ICU Sepsis Intelligence · 纯 iframe 接入（无医院 SSO）
# 复制为 .runtime/iframe.env 后按需修改；不要提交真实密码。
#
# 说明：
# 1) 不需要医院 SSO。宿主只需 iframe 加载 /embed，走 SmartCareReady → SmartCare。
# 2) 192.168.31.185:27017 当前可免密读取 SmartCare / DataCenter；有账号时再填 USERNAME/PASSWORD。
# 3) 业务写库仍须独立 icu_sepsis_* 且支持事务（副本集）。默认本机 27027。
# 4) DOCTOR/NURSE/QUALITY_PASSWORD 是本系统本地 Basic 账号，不是医院 SSO；iframe 路径一般用不到，
#    但启动时 Spring Security 仍要求设置三个互不相同的 ≥16 位密码。

CLINICAL_SOURCE_MODE=smartcare
DEMO_MODE=false

# —— 医院源库（只读）——
SMARTCARE_MONGO_URI=mongodb://192.168.31.185:27017/SmartCare
DATACENTER_MONGO_URI=mongodb://192.168.31.185:27017/DataCenter
# 有认证时启用（与 URI 内嵌账号二选一；URI 已写 user:pass 时忽略这两项）
SMARTCARE_MONGO_USERNAME=
SMARTCARE_MONGO_PASSWORD=
SMARTCARE_MONGO_AUTH_SOURCE=
DATACENTER_MONGO_USERNAME=
DATACENTER_MONGO_PASSWORD=
DATACENTER_MONGO_AUTH_SOURCE=

# —— 本系统业务写库（评估/预警/任务只写这里）——
MONGODB_URI=mongodb://127.0.0.1:27027/icu_sepsis_demo?replicaSet=rs0
MONGODB_USERNAME=
MONGODB_PASSWORD=

# —— 宿主 iframe——
# 宿主站点 origin，例如 http://192.168.31.167:60000 或 http://192.168.31.167
EMBED_PARENT_ORIGINS=
EMBED_ALLOW_INSECURE_LAN_ORIGINS=true

# 本地 Basic 账号（非 SSO；可用任意 ≥16 位随机串）
DOCTOR_PASSWORD=change-me-doctor-16plus
NURSE_PASSWORD=change-me-nurse-16plus
QUALITY_PASSWORD=change-me-quality-16plus
